# Database — use host.docker.internal to reach PostgreSQL on the host machine
DATABASE_URL="postgresql://user:password@host.docker.internal:5432/spagram?schema=public"

# NextAuth — set to your VPS IP/domain
NEXTAUTH_URL="http://<VPS_IP>:3001"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# UploadThing
UPLOADTHING_SECRET="sk_live_..."
UPLOADTHING_APP_ID=""

# Resend (email)
RESEND_API_KEY="re_..."

# App URL — must match NEXTAUTH_URL
NEXT_PUBLIC_APP_URL="http://<VPS_IP>:3001"
