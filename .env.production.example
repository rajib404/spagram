# Database — connects to the spagram-db container
DATABASE_URL="postgresql://spagram:${DB_PASSWORD}@spagram-db:5432/spagram?schema=public"

# Database password — used by both the app and the postgres container
DB_PASSWORD="generate-a-strong-password-here"

# NextAuth — set to your domain (behind websouq nginx proxy)
NEXTAUTH_URL="https://spagram.yourdomain.com"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# UploadThing
UPLOADTHING_SECRET="sk_live_..."
UPLOADTHING_APP_ID=""

# Resend (email)
RESEND_API_KEY="re_..."

# App URL — must match NEXTAUTH_URL
NEXT_PUBLIC_APP_URL="https://spagram.yourdomain.com"
