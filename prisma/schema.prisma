generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────────

enum Role {
  CLIENT
  THERAPIST
  ADMIN
}

enum LocationType {
  INCALL
  OUTCALL
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
  NO_SHOW
}

// ─── NextAuth Models ────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── User ───────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?
  firstName     String?
  lastName      String?
  phone         String?
  role          Role      @default(CLIENT)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastActiveAt  DateTime?

  stripeCustomerId String?

  accounts         Account[]
  sessions         Session[]
  therapistProfile TherapistProfile?
  bookings         Booking[]
  reviews          Review[]
  favorites        Favorite[]
  messages         Message[]
}

// ─── Therapist Profile ──────────────────────────────────────────────────────────

model TherapistProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  displayName String
  slug        String  @unique
  bio         String? @db.Text
  tagline     String?

  // Photos
  profilePhoto  String?
  galleryPhotos String[]

  // Personal details
  gender    String?
  ethnicity String?
  age       Int?
  height    String?
  weight    String?
  hairColor String?
  eyeColor  String?

  // Location
  state       String?
  city        String?
  borough     String?
  fullAddress String?
  latitude    Float?
  longitude   Float?

  // Services
  massageTypes        String[]
  incallAvailable     Boolean  @default(false)
  outcallAvailable    Boolean  @default(false)
  incallPricePerHour  Decimal? @db.Decimal(10, 2)
  outcallPricePerHour Decimal? @db.Decimal(10, 2)
  incallAddress       String?
  outcallRadius       Int?

  // Status
  isVerified  Boolean  @default(false)
  isActive    Boolean  @default(true)
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability           Availability[]
  availabilityExceptions AvailabilityException[]
  bookings               Booking[]
  reviews                Review[]
  favoritedBy            Favorite[]

  @@index([slug])
  @@index([state, city])
  @@index([isActive])
}

// ─── Availability ───────────────────────────────────────────────────────────────

model Availability {
  id                 String  @id @default(cuid())
  therapistProfileId String
  dayOfWeek          Int // 0 = Sunday, 6 = Saturday
  startTime          String // "HH:mm"
  endTime            String // "HH:mm"
  isActive           Boolean @default(true)

  therapistProfile TherapistProfile @relation(fields: [therapistProfileId], references: [id], onDelete: Cascade)

  @@index([therapistProfileId, dayOfWeek])
}

model AvailabilityException {
  id                 String   @id @default(cuid())
  therapistProfileId String
  date               DateTime
  isAvailable        Boolean
  startTime          String?
  endTime            String?
  reason             String?

  therapistProfile TherapistProfile @relation(fields: [therapistProfileId], references: [id], onDelete: Cascade)
}

// ─── Booking ────────────────────────────────────────────────────────────────────

model Booking {
  id                    String        @id @default(cuid())
  bookingNumber         String        @unique
  clientId              String
  therapistProfileId    String
  date                  DateTime
  startTime             String
  endTime               String
  duration              Int // minutes
  serviceType           String
  locationType          LocationType
  outcallAddress        String?
  totalPrice            Decimal       @db.Decimal(10, 2)
  bookingFee            Decimal       @db.Decimal(10, 2)
  status                BookingStatus @default(PENDING)
  stripePaymentIntentId String?
  stripeIdempotencyKey  String?       @unique
  clientNotes           String?       @db.Text
  therapistNotes        String?       @db.Text
  acceptRejectToken     String?       @unique
  tokenExpiresAt        DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  client           User             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  therapistProfile TherapistProfile @relation(fields: [therapistProfileId], references: [id], onDelete: Cascade)
  review           Review?
  messages         Message[]

  @@index([status])
  @@index([clientId])
  @@index([therapistProfileId])
  @@index([acceptRejectToken])
}

// ─── Review ─────────────────────────────────────────────────────────────────────

model Review {
  id                 String   @id @default(cuid())
  bookingId          String   @unique
  clientId           String
  therapistProfileId String
  rating             Int // 1-5
  title              String?
  comment            String?  @db.Text
  isVisible          Boolean  @default(true)
  therapistResponse  String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  booking          Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  client           User             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  therapistProfile TherapistProfile @relation(fields: [therapistProfileId], references: [id], onDelete: Cascade)

  @@index([therapistProfileId])
}

// ─── Favorite ───────────────────────────────────────────────────────────────────

model Favorite {
  id                 String   @id @default(cuid())
  userId             String
  therapistProfileId String
  createdAt          DateTime @default(now())

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  therapistProfile TherapistProfile @relation(fields: [therapistProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, therapistProfileId])
}

// ─── Message ─────────────────────────────────────────────────────────────────

model Message {
  id        String   @id @default(cuid())
  bookingId String
  senderId  String
  content   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@index([senderId])
}

// ─── Platform Settings ───────────────────────────────────────────────────────

model PlatformSettings {
  id                  String   @id @default("singleton")
  bookingFeePercent   Float    @default(10)
  supportedMassageTypes String[] @default(["Swedish", "Deep Tissue", "Sports", "Thai", "Hot Stone", "Prenatal", "Aromatherapy", "Reflexology", "Shiatsu", "Lymphatic Drainage"])
  supportedStates     String[] @default(["New York", "California", "Florida", "Texas", "Illinois"])
  updatedAt           DateTime @updatedAt
}
